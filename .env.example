POSTGRES_USER=gatekeep
POSTGRES_PASSWORD=replace_with_a_random_database_password
POSTGRES_DB=gatekeep

DATABASE_URL=postgresql://gatekeep:replace_with_a_random_database_password@localhost:5433/gatekeep

JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Number of trusted reverse-proxy hops. Leave blank when directly exposed.
TRUST_PROXY=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
